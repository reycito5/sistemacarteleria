# ============================================================================
# SICD UABJB POSGRADO — variables de entorno
# ----------------------------------------------------------------------------
# Copie este archivo a .env.local y complete los valores de su proyecto
# Supabase. NUNCA suba .env.local al repositorio.
# ============================================================================

# --- Públicas (llegan al navegador y a los reproductores) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima

# --- Privadas (SOLO servidor — nunca en los reproductores) ------------------
# Usada por los Route Handlers de telemetría (heartbeats). No exponer jamás.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-de-servicio

# --- Integración (opcional) -------------------------------------------------
# Portal de Oferta Académica. Basta con el dominio: el sistema prueba por su
# cuenta /api/programas, /api/programs, /api/oferta y, si ninguna responde, lee
# los datos incrustados en el HTML. También acepta una ruta JSON concreta.
# Si se omite, se usa una oferta de muestra interna.
# Guía completa: docs/portal-oferta.md
OFERTA_PORTAL_URL=https://ofertaposgrado.vercel.app
